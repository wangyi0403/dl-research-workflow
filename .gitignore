# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Python and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Raw/restricted data and large experiment outputs
data/raw/
data/restricted/
results/data/*
!results/data/.gitkeep
results/logs/*
!results/logs/.gitkeep
results/checkpoints/
*.ckpt
*.pth
*.pt

# LaTeX build products
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz

# AgentHub local bookkeeping and recoveries
.agenthub/*.json
.agenthub/removed-skills/
.agenthub/removed-template/

# Local adapter copies and user project state
.claude/skills/
.agenthub/project.json
.validation/
