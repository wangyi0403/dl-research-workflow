{
  "schema_version": 1,
  "template": "research-deep-learning-project",
  "template_version": "3.0.0",
  "install_policy": "core-on-initialize",
  "all_catalog_skills_selectable": true,
  "catalog": {
    "path": "skills-catalog.json",
    "selection_command": "python tools/project.py list",
    "installation_command": "python tools/project.py add <project-path> --profile <profile>",
    "selection_rule": "Select the smallest relevant profile or bundled skill set. External operations and paid resources require project authorization."
  },
  "runtime_dependencies": [
    {
      "name": "latex-paper-en",
      "required_by": [
        "paper-audit"
      ],
      "source_subpath": "scripts",
      "destination": ".agenthub/runtime/latex-paper-en/scripts",
      "file_patterns": [
        "parsers.py",
        "analyze_grammar.py",
        "analyze_logic.py",
        "analyze_experiment.py",
        "analyze_sentences.py",
        "deai_check.py",
        "verify_bib.py",
        "check_figures.py",
        "check_pseudocode.py",
        "check_format.py"
      ],
      "purpose": "paper-audit loads its parser and English check scripts from this project-local support bundle; it is not installed as a discoverable Skill."
    }
  ],
